<h2>Add Task</h2>
<form action="/tasks/add" method="post" class="mt-3">
  {{#if errors}} {{#each errors}} <div class="alert alert-danger">{{this.msg}}</div> {{/each}} {{/if}}
  <div class="mb-3">
    <label class="form-label">Title</label>
    <input name="title" class="form-control" value="{{title}}" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Description</label>
    <textarea name="description" class="form-control">{{description}}</textarea>
  </div>
  <div class="mb-3">
    <label class="form-label">Due Date</label>
    <input type="date" name="dueDate" class="form-control" value="{{dueDate}}">
  </div>
  <button class="btn btn-success">Add</button>
  <a href="/tasks" class="btn btn-link">Cancel</a>
</form>
