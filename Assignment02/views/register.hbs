<h2>Register</h2>
<form action="/auth/register" method="post" class="mt-3">
  {{#if errors}} {{#each errors}} <div class="alert alert-danger">{{this.msg}}</div> {{/each}} {{/if}}
  <div class="mb-3">
    <label class="form-label">Email</label>
    <input name="email" class="form-control" value="{{email}}" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Password</label>
    <input type="password" name="password" class="form-control" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Confirm Password</label>
    <input type="password" name="password2" class="form-control" required>
  </div>
  <button class="btn btn-primary">Register</button>
  <a href="/auth/github" class="btn btn-dark ms-2">Register / Login with GitHub</a>
</form>
