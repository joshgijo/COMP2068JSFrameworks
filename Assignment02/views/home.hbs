<div class="jumbotron p-5 bg-light rounded-3">
  <div class="container">
    <h1 class="display-5">Organize your day. Get things done.</h1>
    <p class="lead">A simple, clean Task Tracker with private accounts, GitHub login, and search.</p>
    <p>
      {{#if currentUser}}
        <a href="/tasks" class="btn btn-primary btn-lg">Go to My Tasks</a>
      {{else}}
        <a href="/auth/register" class="btn btn-primary btn-lg">Get Started</a>
        <a href="/auth/login" class="btn btn-outline-primary btn-lg">Log in</a>
      {{/if}}
      <a href="/public-tasks" class="btn btn-link">View Public Directory</a>
    </p>
  </div>
</div>
